# MailFlow environment. Copy to .env (never commit it) or run scripts/generate-env.sh.
# Every variable is documented in docs/DOCKER.md.

# --- Public address -------------------------------------------------------------------------
# URL users type in the browser. Must be https:// in production.
APP_BASE_URL=http://localhost:8080
# Host names the API accepts (comma separated JSON list is also accepted).
ALLOWED_HOSTS=["localhost"]
# Port published by Nginx on the host (local stack only).
HTTP_PORT=8080
ENVIRONMENT=development
LOG_LEVEL=INFO
API_DOCS_ENABLED=false

# --- PostgreSQL -----------------------------------------------------------------------------
POSTGRES_DB=mailflow
# Owner role: runs migrations only.
POSTGRES_USER=mailflow_owner
POSTGRES_PASSWORD=change-me-owner
# Restricted application role (no ownership, no BYPASSRLS): used by API and workers.
MAILFLOW_APP_PASSWORD=change-me-app

# --- Redis ----------------------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis

# --- Token Vault (AES-256-GCM) --------------------------------------------------------------
# Comma separated "key_id:base64(32 random bytes)". Generate a key with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
VAULT_KEYS=k1:REPLACE_WITH_BASE64_KEY
VAULT_PRIMARY_KEY_ID=k1

# --- Google OAuth (Gmail) -------------------------------------------------------------------
# Leave empty to run without Gmail; the UI then shows the provider as not configured.
# Redirect URI to register in Google Cloud: ${APP_BASE_URL}/api/v1/accounts/oauth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft OAuth (Outlook / Microsoft 365) ----------------------------------------------
# Leave empty to run without Outlook; the UI then shows the provider as not configured.
# Redirect URI to register in Microsoft Entra (platform "Web"):
#   ${APP_BASE_URL}/api/v1/accounts/oauth/outlook/callback
# MICROSOFT_TENANT: common (work, school and personal accounts), organizations, consumers
# or a tenant id. Setup steps: docs/EMAIL_INTEGRATION.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- System mail (verification, password reset) ---------------------------------------------
# The local stack ships Mailpit (inbox UI at http://127.0.0.1:8025): mail sent there never
# reaches a real inbox. For real delivery use a provider's SMTP relay, for example
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_STARTTLS=true   (STARTTLS)
#   SMTP_HOST=smtp.resend.com       SMTP_PORT=465  SMTP_TLS=true        (implicit TLS)
#   SMTP_HOST=smtp.gmail.com        SMTP_PORT=587  SMTP_STARTTLS=true   (app password)
# and publish SPF/DKIM for the MAIL_FROM domain. Production refuses to start with Mailpit or
# without STARTTLS/TLS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TLS=false
MAIL_FROM=MailFlow <no-reply@mailflow.local>
REQUIRE_EMAIL_VERIFICATION=true

# --- Sessions -------------------------------------------------------------------------------
SESSION_TTL_HOURS=336
SESSION_IDLE_TIMEOUT_HOURS=168

# --- Synchronization ------------------------------------------------------------------------
SYNC_INTERVAL_SECONDS=120
SYNC_BACKFILL_MAX_MESSAGES=5000
# Timeouts for user-supplied IMAP/SMTP servers (optional; IMAP needs no other configuration).
# MAIL_CONNECT_TIMEOUT_SECONDS=10
# MAIL_IO_TIMEOUT_SECONDS=30
CELERY_CONCURRENCY=4
